<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>../../../Assemblies</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <Nullable>warnings</Nullable>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>VanillaRacesExpandedFungoid</RootNamespace>
    <AssemblyName>VanillaRacesExpanded-Fungoid</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony">
      <Version>*</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\..\..\..\Assembly-CSharp.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>..\..\..\..\..\..\RimWorld.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\..\..\..\..\..\UnityStubs.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>..\..\..\..\..\..\Waylith.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="VanillaExpandedFramework">
      <HintPath>..\..\..\..\..\VanillaExpandedFramework\1.7\Assemblies\VEF.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>